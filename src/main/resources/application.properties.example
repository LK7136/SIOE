# === Serveur ===
server.port=8443
server.ssl.enabled=true
server.ssl.key-store=classpath:hellmetz-keystore.p12
server.ssl.key-store-type=PKCS12
server.ssl.key-store-password=hellmetz

# === Base de donnees ===
spring.datasource.url=jdbc:postgresql://"IP_DE_LA_BDD_SANS_GUILLEMETS":5432/hellmetz_db?sslmode=disable&connectTimeout=30&socketTimeout=60
spring.datasource.username="NOM_UTILISATEUR_BDD_SANS_GUILLEMETS"
spring.datasource.password="MDP_BDD_SANS_GUILLEMETS"
spring.datasource.driver-class-name=org.postgresql.Driver

# === HikariCP ===
spring.datasource.hikari.maximum-pool-size=3
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.max-lifetime=120000
spring.datasource.hikari.register-mbeans=true
# MODIFIE ? 30000 ? 60000 pour éviter les faux positifs
spring.datasource.hikari.leak-detection-threshold=60000
# MODIFIE ? 10000 ? 300000 (10s c'est trop court, connexion tuée trop vite)
spring.datasource.hikari.idle-timeout=300000

# === Flyway ===
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.url=jdbc:postgresql://127.0.0.1:5433/hellmetz_db?sslmode=disable
spring.flyway.user=hellmetz
spring.flyway.password=VOLABEBOL_SERV_2261

# === JPA / Hibernate ===
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.default_schema=hellmetz
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# === Thymeleaf ===
spring.thymeleaf.cache=false
spring.thymeleaf.encoding=UTF-8

## === Shutdown ===
#server.shutdown=graceful
#spring.lifecycle.timeout-per-shutdown-phase=30s

# === Upload ===
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Parametrage du dashboard
dashboard.changeover-seuil-minutes=10
dashboard.apercu-fenetre-minutes=90
dashboard.rafraichissement-secondes=30